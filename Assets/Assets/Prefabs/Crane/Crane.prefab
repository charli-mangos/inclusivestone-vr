  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - title: Ganchos y cables
    fact: 'Comprueba que:'
    extraData:
    - 'Los ganchos disponen de pestillo de seguridad y se encunetran en buen estado. '
    - 'El estado de los cables no presenta desgaste, rotura de alambres, cocas... '
    - 'Los cables de los puentes se encuentran correctamente enrollados. '
    - "Los cables de los puentes no presentan corrosi\xF3n. "
    options: []
  - title: "Accesorios de elevaci\xF3n"
    fact: 'Comprueba que:'
    extraData:
    - "Figura una indicaci\xF3n claramente visible de su carga nominal. "
    - "Los accesorios de elevaci\xF3n est\xE1n marcados de forma que se pueden identificar
      las caracter\xEDsticas esenciales. "
    - "Se lleva a cabo el check list de control de las eslingas, as\xED como de otros
      accesorios de elevaci\xF3n necesarios."
    options: []
