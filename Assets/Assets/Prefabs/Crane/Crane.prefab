--- !u!114 &5535655820075962742
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5535655820075962740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ada1edca1467b0b479db545b783636c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - title: Visibilidad
    fact: Si la carga impide la visibilidad ...
    extraData: []
    options:
    - name: Option_1
      fact: Conduciremos marcha adelante siempre y cuando no haya muelles o resaltos
        sin protecciones.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
    - name: Option_2
      fact: "Se debe de conducir marcha atr\xE1s con mucha precauci\xF3n."
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 1
    - name: Option_3
      fact: "No la cargamos, dejamos que lo haga el compa\xF1ero."
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
  - title: "Circulaci\xF3n"
    fact: "Cuando estamos circulando con la carretilla\u2026:"
    extraData: []
    options:
    - name: Option_1
      fact: Nunca circularemos con las horquillas levantadas.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
    - name: Option_2
      fact: Debemos de tocar el claxon siempre que crucemos una puerta.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
    - name: Option_2
      fact: Las dos opciones son correctas.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 1
  - title: Fallo
    fact: "\xBFCu\xE1l ser\xEDa el comportamiento correcto de un carretillero que
      observa alg\xFAn fallo en el veh\xEDculo? "
    extraData: []
    options:
    - name: Option_1
      fact: Intenta repararlo por su cuenta.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
    - name: Option_2
      fact: 'Intenta finalizar el turno de trabajo e informa posteriormente a su
        encargado '
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
    - name: Option_3
      fact: Informa de inmediato a su superior o responsable.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 1
  - title: Afirmaciones
    fact: "\xBFCu\xE1l de las siguientes afirmaciones es verdadera?"
    extraData: []
    options:
    - name: Option_1
      fact: 'Siempre debemos de tener nuestro cuerpo y extremidades dentro del volumen
        de seguridad de la caretilla. '
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 1
    - name: Option_2
      fact: 'Nunca debemos de llevar faro-giratorio (rotativo) en la carretilla elevadora. '
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
    - name: Option_3
      fact: "El descenso de pendientes se realizar\xE1 siempre marcha hacia delante. "
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
  - title: "Cintur\xF3n"
    fact: "El uso del cintur\xF3n de seguridad ser\xE1 obligatorio para el uso del
      equipo. "
    extraData: []
    options:
    - name: Option_1
      fact: Falso.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
    - name: Option_2
      fact: Verdadero.
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 1
    - name: Option_3
      fact: "Verdadero, con la excepci\xF3n de cuando estemos circulando a menos
        de 5 km/h."
      image: {fileID: 0}
      highLightIMG: {fileID: 0}
      response: 
      isCorrect: 0
  factText: {fileID: 5535655820501819840}
  dotsText: {fileID: 0}
  options:
  - {fileID: 5535655819784265959}
  - {fileID: 5535655821589166469}
  - {fileID: 5535655821184023881}
  responses: []
  continuar: {fileID: 0}
